using "ui/basic.style";
using "ui/widgets/widgets.style";
using "ui/layers/layers.style";
using "info/info.style";

pluginsCardMargin: margins(12px, 5px, 12px, 5px);
pluginsCardPadding: margins(14px, 12px, 12px, 10px);
pluginsCardRadius: 12px;
pluginsCardIconSize: 44px;
pluginsCardIconRadius: 12px;
pluginsCardIconSkip: 12px;
pluginsCardLineSkip: 2px;
pluginsCardBlockSkip: 8px;
pluginsCardNameStyle: TextStyle(defaultTextStyle) {
	font: font(14px semibold);
}
pluginsCardMetaStyle: TextStyle(defaultTextStyle) {
	font: font(12px);
}
pluginsCardTextStyle: TextStyle(defaultTextStyle) {
	font: font(13px);
}
pluginsCardBadgeFont: font(11px);
pluginsCardBadgeHeight: 20px;
pluginsCardBadgePadding: 8px;
pluginsCardBadgeSkip: 6px;
pluginsCardBadgeRadius: 6px;
pluginsCardToggle: infoProfileToggle;
pluginsCardActionsTop: 6px;

pluginsCardAction: IconButton(defaultIconButton) {
	width: 36px;
	height: 36px;
	icon: icon {{ "menu/share", windowSubTextFg }};
	iconOver: icon {{ "menu/share", windowBoldFg }};
	iconPosition: point(-1px, -1px);
	rippleAreaPosition: point(2px, 2px);
	rippleAreaSize: 32px;
	ripple: defaultRippleAnimationBgOver;
}
pluginsActionShare: icon {{ "menu/share", windowSubTextFg }};
pluginsActionShareOver: icon {{ "menu/share", windowBoldFg }};
pluginsActionJournal: icon {{ "menu/file", windowSubTextFg }};
pluginsActionJournalOver: icon {{ "menu/file", windowBoldFg }};
pluginsActionFolder: icon {{ "menu/show_in_folder", windowSubTextFg }};
pluginsActionFolderOver: icon {{ "menu/show_in_folder", windowBoldFg }};
pluginsActionReload: icon {{ "menu/restart_bot", windowSubTextFg }};
pluginsActionReloadOver: icon {{ "menu/restart_bot", windowBoldFg }};
pluginsActionDelete: icon {{ "menu/delete", attentionButtonFg }};
pluginsActionDeleteOver: icon {{ "menu/delete", attentionButtonFgOver }};

pluginsEngineIconPower: icon {{ "menu/power_usage", settingsIconFg }};
pluginsEngineIconCode: icon {{ "menu/bot_commands", settingsIconFg }};
pluginsEngineIconCompact: icon {{ "menu/customize", settingsIconFg }};
pluginsEngineIconSources: icon {{ "menu/download", settingsIconFg }};
pluginsEngineIconCheck: icon {{ "menu/permissions", settingsIconFg }};
pluginsEngineIconConfirm: icon {{ "menu/2sv_on", settingsIconFg }};
pluginsEngineIconSafe: icon {{ "menu/stealth", settingsIconFg }};

pluginsInstallIconSize: 72px;
pluginsInstallIconRadius: 18px;
pluginsInstallIconTop: 8px;
pluginsInstallName: FlatLabel(defaultFlatLabel) {
	minWidth: 160px;
	textFg: windowBoldFg;
	align: align(top);
	style: TextStyle(defaultTextStyle) {
		font: font(16px semibold);
	}
}
pluginsInstallMeta: FlatLabel(defaultFlatLabel) {
	minWidth: 160px;
	textFg: windowSubTextFg;
	align: align(top);
}
pluginsInstallText: FlatLabel(defaultFlatLabel) {
	minWidth: 260px;
}
pluginsInstallSection: FlatLabel(defaultFlatLabel) {
	minWidth: 160px;
	textFg: windowSubTextFg;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}
pluginsPermissionIconLeft: 0px;
pluginsPermissionTextLeft: 36px;
pluginsPermissionSkip: 6px;

pluginsJournalText: FlatLabel(defaultFlatLabel) {
	minWidth: 360px;
	style: TextStyle(defaultTextStyle) {
		font: font(12px);
	}
}

// Catalog.
pluginsCatalogLogoSize: 84px;
pluginsCatalogLogoTop: 12px;
pluginsCatalogTitle: FlatLabel(defaultFlatLabel) {
	minWidth: 160px;
	align: align(top);
	style: TextStyle(defaultTextStyle) {
		font: font(18px semibold);
	}
}
pluginsCatalogAbout: FlatLabel(defaultFlatLabel) {
	minWidth: 220px;
	align: align(top);
	textFg: windowSubTextFg;
}
pluginsCatalogAboutPadding: margins(28px, 6px, 28px, 8px);

pluginsSourceHeight: 60px;
pluginsSourceBigHeight: 76px;
pluginsSourceUserpic: 42px;
pluginsSourceBigUserpic: 56px;
pluginsSourceLeft: 22px;
pluginsSourceTextSkip: 14px;
pluginsSourceRight: 12px;
pluginsSourceLineSkip: 3px;
pluginsSourceNameStyle: TextStyle(defaultTextStyle) {
	font: font(14px semibold);
}
pluginsSourceBigNameStyle: TextStyle(defaultTextStyle) {
	font: font(16px semibold);
}
pluginsSourceStatusFont: font(13px);
pluginsSourceBadgeSkip: 4px;

pluginsCatalogCardPadding: margins(14px, 12px, 6px, 12px);
pluginsCatalogTextRight: 8px;
pluginsCatalogVersionFont: font(11px);
pluginsCatalogVersionHeight: 18px;
pluginsCatalogVersionPadding: 6px;
pluginsCatalogVersionSkip: 8px;
pluginsCatalogAuthorStyle: TextStyle(defaultTextStyle) {
	font: font(12px);
}
pluginsCatalogEmptyPadding: margins(22px, 12px, 22px, 12px);

pluginsCatalogChipsPadding: margins(18px, 4px, 18px, 8px);
pluginsCatalogChipHeight: 30px;
pluginsCatalogChipPadding: 13px;
pluginsCatalogChipSkip: 8px;
pluginsCatalogChipFont: font(13px semibold);

pluginsActionInstall: icon {{ "menu/download", windowActiveTextFg }};
pluginsActionInstallOver: icon {{ "menu/download", windowActiveTextFg }};
pluginsActionUpdate: icon {{ "menu/restore", windowActiveTextFg }};
pluginsActionUpdateOver: icon {{ "menu/restore", windowActiveTextFg }};
pluginsActionRemoveSource: icon {{ "menu/delete", windowSubTextFg }};
pluginsActionRemoveSourceOver: icon {{ "menu/delete", attentionButtonFg }};

pluginsActionSettings: icon {{ "menu/settings", windowSubTextFg }};
pluginsActionSettingsOver: icon {{ "menu/settings", windowBoldFg }};

// Pages of plugins.
pluginsPageRowPadding: margins(22px, 9px, 22px, 9px);
pluginsPageRowMinHeight: 48px;
pluginsPageIconSkip: 42px;
pluginsPageLineSkip: 2px;
pluginsPageTitleStyle: TextStyle(defaultTextStyle) {
	font: font(14px);
}
pluginsPageSubtitleStyle: TextStyle(defaultTextStyle) {
	font: font(13px);
}
pluginsPageValueFont: font(14px);
pluginsPageSliderPadding: margins(22px, 0px, 22px, 10px);
